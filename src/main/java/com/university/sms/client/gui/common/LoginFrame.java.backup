package com.university.sms.client.gui.common;

import com.formdev.flatlaf.FlatLightLaf;
import com.university.sms.client.IServerConnection;
import com.university.sms.client.ServerConnection;
import com.university.sms.csvclient.CSVServerConnection;
import com.university.sms.common.Constants;
import com.university.sms.common.Message;
import com.university.sms.model.User;

import javax.swing.*;
import javax.swing.border.EmptyBorder;
import javax.swing.event.DocumentEvent;
import javax.swing.event.DocumentListener;
import java.awt.*;
import java.awt.event.*;

public class LoginFrame extends JFrame {
    // Factory pattern (inner types để tránh tạo file mới)
    public interface ConnectionFactory {
        IServerConnection create(String host, int port);
    }

    public static class RegularConnectionFactory implements ConnectionFactory {
        @Override
        public IServerConnection create(String host, int port) {
            return new ServerConnection(host, port);
        }
    }

    public static class CsvConnectionFactory implements ConnectionFactory {
        @Override
        public IServerConnection create(String host, int port) {
            return new CSVServerConnection(host, port);
        }
    }

    private static final long serialVersionUID = 1L;

    // Fields
    private JTextField usernameField;
    private JPasswordField passwordField;
    private JTextField serverField;
    private JTextField portField;
    private JButton loginButton;
    private JButton connectButton;
    private JButton togglePasswordButton;
    private JLabel statusLabel;
    private JProgressBar progressBar;
    private JLabel clientTypeLabel;

    private IServerConnection serverConnection;
    private ConnectionFactory connectionFactory;
    private boolean isConnectedToServer = false;
    private boolean isPasswordVisible = false;

    // Modern vibrant color scheme
    private static final Color BG = new Color(240, 242, 245);
    private static final Color CARD = Color.WHITE;
    private static final Color ACCENT = new Color(24, 119, 242);  // Facebook blue - nổi bật hơn
    private static final Color ACCENT_DARK = new Color(9, 88, 197);
    private static final Color SUCCESS = new Color(16, 185, 129);  // Modern green - tươi sáng
    private static final Color SUCCESS_DARK = new Color(5, 150, 105);
    private static final Color WARN = new Color(245, 158, 11);
    private static final Color ERROR = new Color(239, 68, 68);
    private static final Color TEXT = new Color(31, 41, 55);
    private static final Color MUTED = new Color(107, 114, 128);

    public LoginFrame() {
        this(new RegularConnectionFactory());
    }

    // Constructor nhận factory
    public LoginFrame(ConnectionFactory factory) {
        this.connectionFactory = factory;
        initLookAndFeel();
        initializeComponents();
        setupLayout();
        setupEventListeners();
        setDefaultServerSettings();
        postInit();
    }

    private void initLookAndFeel() {
        try {
            FlatLightLaf.setup();
            UIManager.setLookAndFeel(new FlatLightLaf());
            UIManager.put("Button.arc", 8);
            UIManager.put("Component.arc", 8);
            UIManager.put("TextComponent.arc", 6);
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    private void initializeComponents() {
        setTitle("Hệ Thống Đồng Bộ Dữ Liệu Giữa Nhiều Máy Trong Mạng — Đăng nhập");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setResizable(false);

        // Fields
        usernameField = createTextField(20);
        passwordField = createPasswordField(20);
        serverField = createTextField(15);
        portField = createTextField(6);  // Đủ chỗ cho 4-5 số port

        serverField.setText("localhost");
        portField.setText("8888");

        // Buttons
        loginButton = createPrimaryButton("Đăng nhập");
        loginButton.setPreferredSize(new Dimension(160, 44));
        connectButton = createSecondaryButton("Kết nối");
        connectButton.setPreferredSize(new Dimension(120, 38));
        togglePasswordButton = createIconButton("👁");
        togglePasswordButton.setPreferredSize(new Dimension(44, 36));
        togglePasswordButton.setToolTipText("Hiện/Ẩn mật khẩu");

        // Status
        statusLabel = new JLabel("✖ Chưa kết nối đến server");
        statusLabel.setForeground(ERROR);
        statusLabel.setFont(statusLabel.getFont().deriveFont(Font.PLAIN, 13f));
        statusLabel.setHorizontalAlignment(SwingConstants.CENTER);

        // Progress bar
        progressBar = new JProgressBar();
        progressBar.setVisible(false);
        progressBar.setIndeterminate(true);
        progressBar.setPreferredSize(new Dimension(380, 6));
        progressBar.setBorder(BorderFactory.createEmptyBorder());
        progressBar.setForeground(ACCENT);

        // client type
        clientTypeLabel = new JLabel("Loại client: " + (connectionFactory instanceof CsvConnectionFactory ? "CSV" : "Regular"));
        clientTypeLabel.setFont(clientTypeLabel.getFont().deriveFont(Font.PLAIN, 12f));
        clientTypeLabel.setForeground(MUTED);

        // disable login initially
        loginButton.setEnabled(false);
    }

    // Helpers to create styled controls
    private JTextField createTextField(int columns) {
        JTextField t = new JTextField(columns);
        t.setFont(new Font("Segoe UI", Font.PLAIN, 14));
        t.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(new Color(209, 213, 219), 1, true),
                new EmptyBorder(8, 12, 8, 12)
        ));
        t.setBackground(Color.WHITE);
        
        // Add focus effect
        t.addFocusListener(new FocusAdapter() {
            @Override
            public void focusGained(FocusEvent e) {
                t.setBorder(BorderFactory.createCompoundBorder(
                    BorderFactory.createLineBorder(ACCENT, 2, true),
                    new EmptyBorder(7, 11, 7, 11)
                ));
            }

            @Override
            public void focusLost(FocusEvent e) {
                t.setBorder(BorderFactory.createCompoundBorder(
                    BorderFactory.createLineBorder(new Color(209, 213, 219), 1, true),
                    new EmptyBorder(8, 12, 8, 12)
                ));
            }
        });
        
        return t;
    }

    private JPasswordField createPasswordField(int columns) {
        JPasswordField p = new JPasswordField(columns);
        p.setFont(new Font("Segoe UI", Font.PLAIN, 14));
        p.setBorder(BorderFactory.createCompoundBorder(
                BorderFactory.createLineBorder(new Color(209, 213, 219), 1, true),
                new EmptyBorder(8, 12, 8, 12)
        ));
        p.setBackground(Color.WHITE);
        p.setEchoChar('\u2022'); // bullet
        
        // Add focus effect
        p.addFocusListener(new FocusAdapter() {
            @Override
            public void focusGained(FocusEvent e) {
                p.setBorder(BorderFactory.createCompoundBorder(
                    BorderFactory.createLineBorder(ACCENT, 2, true),
                    new EmptyBorder(7, 11, 7, 11)
                ));
            }

            @Override
            public void focusLost(FocusEvent e) {
                p.setBorder(BorderFactory.createCompoundBorder(
                    BorderFactory.createLineBorder(new Color(209, 213, 219), 1, true),
                    new EmptyBorder(8, 12, 8, 12)
                ));
            }
        });
        
        return p;
    }

    private JButton createPrimaryButton(String text) {
        JButton b = new JButton(text);
        styleButtonBase(b);
        b.setBackground(ACCENT);
        b.setForeground(Color.WHITE);
        b.setFont(b.getFont().deriveFont(Font.BOLD, 14f));
        
        // Add shadow effect
        b.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createEmptyBorder(2, 2, 4, 2),
            BorderFactory.createEmptyBorder(8, 16, 8, 16)
        ));
        
        b.addMouseListener(new MouseAdapter() {
            @Override
            public void mouseEntered(MouseEvent e) {
                if (b.isEnabled()) {
                    b.setBackground(ACCENT_DARK);
                }
            }

            @Override
            public void mouseExited(MouseEvent e) {
                b.setBackground(ACCENT);
            }
            
            @Override
            public void mousePressed(MouseEvent e) {
                if (b.isEnabled()) {
                    b.setBackground(ACCENT_DARK);
                }
            }
            
            @Override
            public void mouseReleased(MouseEvent e) {
                if (b.isEnabled()) {
                    b.setBackground(b.contains(e.getPoint()) ? ACCENT_DARK : ACCENT);
                }
            }
        });
        return b;
    }

    private JButton createSecondaryButton(String text) {
        JButton b = new JButton(text);
        styleButtonBase(b);
        b.setBackground(SUCCESS);
        b.setForeground(Color.WHITE);
        b.setFont(b.getFont().deriveFont(Font.BOLD, 13f));
        
        // Add shadow effect
        b.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createEmptyBorder(2, 2, 3, 2),
            BorderFactory.createEmptyBorder(8, 14, 8, 14)
        ));
        
        b.addMouseListener(new MouseAdapter() {
            @Override
            public void mouseEntered(MouseEvent e) {
                if (b.isEnabled()) {
                    b.setBackground(SUCCESS_DARK);
                }
            }

            @Override
            public void mouseExited(MouseEvent e) {
                b.setBackground(SUCCESS);
            }
            
            @Override
            public void mousePressed(MouseEvent e) {
                if (b.isEnabled()) {
                    b.setBackground(SUCCESS_DARK);
                }
            }
            
            @Override
            public void mouseReleased(MouseEvent e) {
                if (b.isEnabled()) {
                    b.setBackground(b.contains(e.getPoint()) ? SUCCESS_DARK : SUCCESS);
                }
            }
        });
        return b;
    }

    private JButton createIconButton(String icon) {
        JButton b = new JButton(icon);
        styleButtonBase(b);
        b.setBackground(new Color(248, 250, 252));
        b.setBorder(BorderFactory.createCompoundBorder(
            BorderFactory.createLineBorder(new Color(203, 213, 225), 1, true),
            BorderFactory.createEmptyBorder(6, 10, 6, 10)
        ));
        b.setFont(new Font("Segoe UI Emoji", Font.PLAIN, 16));
        
        b.addMouseListener(new MouseAdapter() {
            @Override
            public void mouseEntered(MouseEvent e) {
                b.setBackground(new Color(226, 232, 240));
            }

            @Override
            public void mouseExited(MouseEvent e) {
                b.setBackground(new Color(248, 250, 252));
            }
        });
        return b;
    }

    private void styleButtonBase(AbstractButton b) {
        b.setFocusPainted(false);
        b.setCursor(Cursor.getPredefinedCursor(Cursor.HAND_CURSOR));
        b.setOpaque(true);
        b.setBorderPainted(false);
        b.setMargin(new Insets(8, 12, 8, 12));
    }

    private void setupLayout() {
        getContentPane().setBackground(BG);
        setLayout(new BorderLayout());

        // Root panel centers content and enforces width
        JPanel root = new JPanel(new GridBagLayout());
        root.setOpaque(false);
        root.setBorder(new EmptyBorder(28, 28, 28, 28));

        GridBagConstraints gbc = new GridBagConstraints();
        gbc.gridx = 0; gbc.fill = GridBagConstraints.HORIZONTAL; gbc.anchor = GridBagConstraints.CENTER;

        // Header (gradient + logo)
        gbc.gridy = 0; gbc.insets = new Insets(0, 0, 18, 0);
        root.add(createHeaderPanel(), gbc);

        // Card container (server card + login card)
        gbc.gridy = 1; gbc.insets = new Insets(0, 0, 12, 0);
        JPanel cards = new JPanel();
        cards.setOpaque(false);
        cards.setLayout(new BoxLayout(cards, BoxLayout.Y_AXIS));
        
        // Create cards with flexible height (0 = auto)
        JPanel serverCard = createRoundedCard(createServerConnectionContent(), 560, 0);
        cards.add(serverCard);
        cards.add(Box.createVerticalStrut(12));
        
        JPanel loginCard = createRoundedCard(createLoginContent(), 560, 0);
        cards.add(loginCard);
        
        root.add(cards, gbc);

        // Status and misc
        gbc.gridy = 2; gbc.insets = new Insets(6, 0, 6, 0);
        JPanel status = new JPanel(new BorderLayout());
        status.setOpaque(false);
        status.add(statusLabel, BorderLayout.NORTH);

        JPanel pbWrap = new JPanel();
        pbWrap.setOpaque(false);
        pbWrap.add(progressBar);
        status.add(pbWrap, BorderLayout.CENTER);

        root.add(status, gbc);

        // Client info + footer
        gbc.gridy = 3; gbc.insets = new Insets(8, 0, 0, 0);
        JPanel info = new JPanel(new FlowLayout(FlowLayout.CENTER));
        info.setOpaque(false);
        info.add(clientTypeLabel);
        root.add(info, gbc);

        add(root, BorderLayout.CENTER);

        // Bottom footer small
        // JPanel footer = new JPanel(new FlowLayout(FlowLayout.CENTER));
        // footer.setBackground(new Color(250, 250, 250));
        // footer.setBorder(new EmptyBorder(10, 0, 10, 0));
        // JLabel f = new JLabel("© Hệ thống Quản lý Sinh viên — Phiên bản 1.0");
        // f.setForeground(MUTED);
        // f.setFont(f.getFont().deriveFont(12f));
        // footer.add(f);
        // add(footer, BorderLayout.SOUTH);

        pack();
        setMinimumSize(new Dimension(640, 750));  // Tăng width để phù hợp với cards 560px
        setLocationRelativeTo(null);
    }

    private JPanel createHeaderPanel() {
        JPanel header = new JPanel() {
            @Override
            protected void paintComponent(Graphics g) {
                super.paintComponent(g);
                // Vibrant gradient background
                Graphics2D g2 = (Graphics2D) g.create();
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
                int w = getWidth(), h = getHeight();
                
                // Modern blue gradient
                GradientPaint gp = new GradientPaint(
                    0, 0, new Color(239, 246, 255),  // Light blue
                    0, h, new Color(219, 234, 254)   // Deeper blue
                );
                g2.setPaint(gp);
                g2.fillRect(0, 0, w, h);
                g2.dispose();
            }
        };
        header.setOpaque(false);
        header.setLayout(new BoxLayout(header, BoxLayout.Y_AXIS));
        header.setBorder(new EmptyBorder(12, 16, 12, 16));
        header.setPreferredSize(new Dimension(560, 120));  // Tăng width và height

        JLabel logo = new JLabel("🎓");
        logo.setFont(new Font("Segoe UI Emoji", Font.PLAIN, 56));
        logo.setAlignmentX(Component.CENTER_ALIGNMENT);

        JLabel title = new JLabel("HỆ THỐNG ĐỒNG BỘ DỮ LIỆU");
        title.setFont(new Font("Segoe UI", Font.BOLD, 22));
        title.setForeground(TEXT);
        title.setAlignmentX(Component.CENTER_ALIGNMENT);

        JLabel sub = new JLabel("Đăng nhập để tiếp tục");
        sub.setFont(new Font("Segoe UI", Font.PLAIN, 13));
        sub.setForeground(MUTED);
        sub.setAlignmentX(Component.CENTER_ALIGNMENT);

        header.add(Box.createVerticalStrut(6));
        header.add(logo);
        header.add(Box.createVerticalStrut(8));
        header.add(title);
        header.add(Box.createVerticalStrut(6));
        header.add(sub);

        return header;
    }

    private JPanel createRoundedCard(JPanel content, int width, int prefHeight) {
        JPanel card = new JPanel(new BorderLayout()) {
            @Override
            protected void paintComponent(Graphics g) {
                // Modern card with elevated shadow
                Graphics2D g2 = (Graphics2D) g.create();
                g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

                int arc = 12;
                int shadowOffset = 4;
                int shadowSpread = 8;
                
                // Multi-layer shadow for depth
                for (int i = shadowSpread; i > 0; i--) {
                    int alpha = (int)(8 - i * 0.8);
                    g2.setColor(new Color(0, 0, 0, alpha));
                    g2.fillRoundRect(
                        shadowOffset + (shadowSpread - i) / 2, 
                        shadowOffset + i / 2, 
                        getWidth() - shadowSpread - shadowOffset, 
                        getHeight() - shadowSpread - shadowOffset, 
                        arc, arc
                    );
                }

                // Card background
                g2.setColor(CARD);
                g2.fillRoundRect(0, 0, getWidth() - shadowSpread - shadowOffset, getHeight() - shadowSpread - shadowOffset, arc, arc);
                
                // Subtle inner border for definition
                g2.setColor(new Color(229, 231, 235));
                g2.drawRoundRect(0, 0, getWidth() - shadowSpread - shadowOffset - 1, getHeight() - shadowSpread - shadowOffset - 1, arc, arc);
                
                g2.dispose();
            }
        };
        card.setOpaque(false);
        card.setBorder(new EmptyBorder(20, 24, 24, 24));  // Tăng padding để components không bị chật
        card.add(content, BorderLayout.CENTER);
        
        // Nếu prefHeight = 0, để card tự động điều chỉnh theo content
        if (prefHeight > 0) {
            card.setPreferredSize(new Dimension(width, prefHeight));
        } else {
            // Chỉ set width, height tự động
            card.setMaximumSize(new Dimension(width, Integer.MAX_VALUE));
        }
        return card;
    }

    private JPanel createServerConnectionContent() {
        JPanel p = new JPanel(new GridBagLayout());
        p.setOpaque(false);
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(6, 6, 6, 6);
        gbc.anchor = GridBagConstraints.WEST;
        gbc.fill = GridBagConstraints.HORIZONTAL;

        // Title row
        gbc.gridx = 0; gbc.gridy = 0; gbc.gridwidth = 4;
        JLabel t = new JLabel("▸ Kết nối Server");
        t.setFont(new Font("Segoe UI", Font.BOLD, 15));
        t.setForeground(TEXT);
        p.add(t, gbc);

        // Server label + field
        gbc.gridwidth = 1;
        gbc.gridy = 1;
        gbc.gridx = 0;
        gbc.weightx = 0;
        JLabel serverLabel = new JLabel("Địa chỉ:");
        serverLabel.setForeground(TEXT);
        p.add(serverLabel, gbc);

        gbc.gridx = 1;
        gbc.weightx = 0;  // Không expand
        gbc.fill = GridBagConstraints.NONE;
        serverField.setPreferredSize(new Dimension(260, 36));  // Tăng lên 260px
        p.add(serverField, gbc);

        // Port label
        gbc.gridx = 2;
        gbc.weightx = 0;
        gbc.fill = GridBagConstraints.NONE;
        gbc.insets = new Insets(6, 18, 6, 6);  // Tăng margin trái lên 18px
        JLabel portLabel = new JLabel("Port:");
        portLabel.setForeground(TEXT);
        p.add(portLabel, gbc);

        // Port field
        gbc.gridx = 3;
        gbc.weightx = 0;
        gbc.fill = GridBagConstraints.NONE;
        gbc.insets = new Insets(6, 6, 6, 6);  // Reset insets
        portField.setPreferredSize(new Dimension(120, 36));  // Tăng lên 120px
        p.add(portField, gbc);

        // Connect button center
        gbc.gridx = 0; gbc.gridy = 2; gbc.gridwidth = 4; gbc.weightx = 0;
        gbc.insets = new Insets(14, 6, 6, 6);
        JPanel cb = new JPanel(new FlowLayout(FlowLayout.CENTER));
        cb.setOpaque(false);
        cb.add(connectButton);
        p.add(cb, gbc);

        return p;
    }

    private JPanel createLoginContent() {
        JPanel p = new JPanel(new GridBagLayout());
        p.setOpaque(false);
        GridBagConstraints gbc = new GridBagConstraints();
        gbc.insets = new Insets(8, 6, 6, 6);
        gbc.anchor = GridBagConstraints.WEST;
        gbc.fill = GridBagConstraints.HORIZONTAL;

        // Title
        gbc.gridx = 0; gbc.gridy = 0; gbc.gridwidth = 2;
        JLabel t = new JLabel("▸ Thông tin đăng nhập");
        t.setFont(new Font("Segoe UI", Font.BOLD, 15));
        t.setForeground(TEXT);
        p.add(t, gbc);

        // Username
        gbc.gridy = 1; gbc.gridwidth = 2;
        JLabel uLabel = new JLabel("Tên đăng nhập");
        uLabel.setForeground(TEXT);
        p.add(uLabel, gbc);

        gbc.gridy = 2;
        usernameField.setPreferredSize(new Dimension(400, 36));
        p.add(usernameField, gbc);

        // Password label
        gbc.gridy = 3; gbc.gridx = 0; gbc.gridwidth = 2; gbc.weightx = 1;
        gbc.fill = GridBagConstraints.HORIZONTAL;
        gbc.insets = new Insets(8, 6, 6, 6);  // Reset insets
        JLabel pwLabel = new JLabel("Mật khẩu");
        pwLabel.setForeground(TEXT);
        p.add(pwLabel, gbc);

        // Password field
        gbc.gridy = 4; gbc.gridx = 0; gbc.gridwidth = 1; gbc.weightx = 1;
        gbc.fill = GridBagConstraints.HORIZONTAL;
        gbc.insets = new Insets(6, 6, 6, 6);
        passwordField.setPreferredSize(new Dimension(340, 36));
        p.add(passwordField, gbc);

        // Toggle button
        gbc.gridx = 1; gbc.weightx = 0; 
        gbc.fill = GridBagConstraints.NONE;
        gbc.insets = new Insets(6, 8, 6, 6);  // Thêm margin trái
        p.add(togglePasswordButton, gbc);

        // Login button centered
        gbc.gridx = 0; gbc.gridy = 5; gbc.gridwidth = 2; 
        gbc.insets = new Insets(18, 6, 8, 6);  // Tăng margin top cho button
        JPanel lb = new JPanel(new FlowLayout(FlowLayout.CENTER));
        lb.setOpaque(false);
        lb.add(loginButton);
        p.add(lb, gbc);

        return p;
